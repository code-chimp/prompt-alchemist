{
  "name": "prompt-alchemist",
  "version": "0.1.0",
  "description": "A lightweight, cross-platform desktop app built with Tauri and React 19 that helps developers craft precise, reusable prompts for Large Language Models (LLMs)",
  "keywords": [
    "tauri",
    "react",
    "typescript",
    "desktop-app",
    "electron-alternative",
    "rust",
    "vite",
    "shadcn-ui",
    "tailwindcss",
    "prompt-engineering",
    "llm",
    "ai",
    "prompt-crafting",
    "developer-tools",
    "desktop-app",
    "productivity",
    "prompt-library",
    "personas",
    "guardrails",
    "cross-platform",
    "open-source"
  ],
  "homepage": "https://github.com/code-chimp/prompt-alchemist.git#readme",
  "bugs": {
    "url": "https://github.com/code-chimp/prompt-alchemist.git/issues",
    "email": "tim@code-chimp.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/code-chimp/prompt-alchemist.git.git"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Tim Goshinski",
    "email": "tim@code-chimp.com",
    "url": "https://code-chimp.com"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "cross-env RUST_BACKTRACE=1 tauri dev",
    "tauri:build": "cross-env RUST_BACKTRACE=1 tauri build",
    "clean": "rimraf dist src-tauri/target src-tauri/build",
    "clean:all": "rimraf dist src-tauri/target src-tauri/build node_modules",
    "check": "run-p check:*",
    "check:types": "tsc --noEmit",
    "check:lockfile": "tsx scripts/validate-lockfile.ts",
    "check:rust": "run-s lint:rust:format lint:rust:clippy",
    "e2e:install": "playwright install",
    "e2e:ui": "playwright test --ui",
    "e2e:test": "playwright test --project=chromium",
    "fix": "run-p fix:*",
    "fix:code": "eslint . --fix",
    "fix:format": "prettier --write .",
    "fix:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --",
    "fix:styles": "stylelint \"./src/**/*.css\" --fix",
    "lint": "run-p lint:* lint:rust:*",
    "lint:code": "eslint .",
    "lint:format": "prettier --check .",
    "lint:styles": "stylelint \"./src/**/*.css\"",
    "lint:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "npm run test:unit",
    "test:e2e": "npm run e2e:test",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust": "npm run rust:test",
    "validate": "run-s check lint test:unit",
    "prepare": "husky",
    "postinstall": "node -e \"try { require('fs').accessSync('.initialized'); console.log('\\\\n✅ Dependencies installed successfully\\\\n'); } catch { console.log('\\\\n✅ Dependencies installed successfully\\\\n⚠️  Run \\\\'npm run init\\\\' to personalize this template\\\\n'); }\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^25.0.3",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "validate-npm-package-name": "^7.0.1",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "zod-validation-error": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=10.0.0"
  },
  "volta": {
    "node": "24.12.0"
  }
}
